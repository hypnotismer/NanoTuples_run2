#!/bin/bash

CMSSW_EL7=/cvmfs/cms.cern.ch/common/cmssw-el7

if [ "${SINGULARITY_NAME:-${APPTAINER_NAME:-}}" != "el7:x86_64" ]; then
    echo "Entering cmssw-el7..."
    if [ ! -x "${CMSSW_EL7}" ]; then
        echo "ERROR: ${CMSSW_EL7} is unavailable; the CMS CVMFS repository must be mounted on the worker." >&2
        exit 127
    fi
    exec "${CMSSW_EL7}" --command-to-run "/bin/bash" "$0" "$@"
fi
echo "Now in cmssw-el7!"
echo "Command line: $0 $*"

if [ $# -lt 2 ]; then
    >&2 echo "usage: $(basename "$0") <x509up> <prog> [ <args> ]"
    exit 1
fi

echo "Hello from $0!"
echo "Args: $*"

# Install x509 user proxy.
set -e
export X509_USER_PROXY=/tmp/x509up_u$UID
cp "$1" ${X509_USER_PROXY}
voms-proxy-info

# Turn to user-specified program.
PROG="$2"
shift 2
exec "${PROG}" "$@"
